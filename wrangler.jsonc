{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "competition-groups-beta",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-11-23",
  "routes": [
    {
      "pattern": "main.competitiongroups.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/notify-comp-token"],
  },
}
